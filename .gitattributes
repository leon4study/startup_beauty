# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files (no diff/normalization)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.mp4   binary
*.mov   binary
*.pt    binary
*.pkl   binary
*.onnx  binary
*.h5    binary
*.parquet binary
